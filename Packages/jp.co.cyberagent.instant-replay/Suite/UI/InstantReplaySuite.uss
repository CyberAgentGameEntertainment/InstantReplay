.irs-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: flex-end;
}

.irs-overlay {
    flex-direction: row;
    align-items: center;
    margin: 8px;
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.6);
}

.irs-overlay:hover {
    background-color: rgba(0, 0, 0, 0.75);
}

.irs-overlay__dot {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 5px;
    background-color: rgb(128, 128, 128);
}

.irs-overlay__dot--buffering {
    background-color: rgb(80, 200, 120);
}

.irs-overlay__dot--recording {
    background-color: rgb(230, 60, 60);
}

.irs-overlay__dot--busy {
    background-color: rgb(240, 180, 40);
}

.irs-overlay__dot--faulted {
    background-color: rgb(230, 60, 60);
    opacity: 0.5;
}

.irs-overlay__dot--paused {
    opacity: 0.4;
}

.irs-overlay__label {
    color: rgb(240, 240, 240);
    font-size: 12px;
    -unity-font-style: bold;
}

.irs-panel {
    width: 320px;
    max-width: 90%;
    margin: 0 8px 8px 8px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(24, 24, 24, 0.92);
}

.irs-panel--hidden {
    display: none;
}

.irs-panel Label {
    color: rgb(230, 230, 230);
}

.irs-panel__title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.irs-panel__section {
    margin-top: 8px;
}

.irs-panel__row {
    flex-direction: row;
}

.irs-panel__row > Button {
    flex-grow: 1;
    flex-basis: 0;
}

.irs-panel .irs-panel__details {
    font-size: 11px;
    white-space: normal;
    color: rgb(170, 170, 170);
    margin: 2px 3px 0 3px;
}

.irs-panel .irs-panel__error {
    font-size: 11px;
    white-space: normal;
    color: rgb(255, 120, 110);
    margin: 6px 3px 0 3px;
}

.irs-panel__error--hidden {
    display: none;
}

.irs-panel .unity-base-field__label {
    min-width: 0;
    margin-right: 8px;
}

.irs-panel .unity-base-popup-field__input {
    flex-grow: 1;
    flex-shrink: 1;
}

.irs-panel {
    max-height: 90%;
}

.irs-panel__scroll {
    flex-shrink: 1;
}

.irs-preset-editor {
    margin-top: 4px;
}

.irs-preset-editor .unity-base-field {
    flex-direction: column;
    align-items: stretch;
    margin-top: 4px;
}

.irs-preset-editor .unity-base-field__label {
    min-width: 0;
    margin-bottom: 2px;
    font-size: 11px;
}

.irs-preset-editor .unity-toggle {
    flex-direction: row;
    align-items: center;
}

.irs-preset-editor .unity-foldout__checkmark {
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.irs-preset-editor .unity-foldout__text {
    color: rgb(230, 230, 230);
}

.irs-tabs {
    flex-direction: row;
    margin-bottom: 4px;
}

.irs-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
    border-radius: 0;
    border-width: 0 0 2px 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 170, 170);
}

.irs-tab:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.irs-tab--selected {
    border-color: rgb(80, 200, 120);
    color: rgb(240, 240, 240);
}

.irs-library__row {
    padding: 6px 6px;
    margin: 2px 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
}

.irs-library__row:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.irs-panel .irs-library__row-title {
    font-size: 12px;
    -unity-font-style: bold;
}

.irs-library__back {
    align-self: flex-start;
}

.irs-preview {
    width: 100%;
    height: 160px;
    margin: 4px 0;
    background-color: rgb(0, 0, 0);
}

.irs-library__comment .unity-text-field__input {
    min-height: 40px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.irs-panel .irs-library__comment {
    flex-direction: column;
    align-items: stretch;
}

.irs-recovery {
    padding: 6px;
    margin-bottom: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(240, 180, 40);
}

.irs-panel .irs-recovery__title {
    -unity-font-style: bold;
    color: rgb(240, 180, 40);
}

.irs-recovery__row {
    margin-top: 6px;
}

.irs-panel .irs-recovery__label {
    font-size: 11px;
    white-space: normal;
}

.irs-button--armed {
    background-color: rgb(160, 50, 45);
    color: rgb(255, 255, 255);
}

@import url("unity-theme://default");

/* Drop-down menus open at the root of the panel, outside the elements that the suite style sheet applies to. */

.unity-base-dropdown__container-outer {
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(52, 55, 62);
    background-color: rgb(30, 33, 39);
}

/* Unity 2022.3 sizes the outer container from the height of the inner one and its own borders, so the inner container
   must not have margins. */

.unity-base-dropdown__container-inner {
    padding: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__item {
    min-height: 28px;
    padding: 0 8px;
    border-radius: 6px;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:hover:enabled {
    background-color: rgb(46, 49, 57);
}

.unity-base-dropdown__label {
    color: rgb(236, 238, 242);
    font-size: 13px;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(62, 196, 136);
}

/* Scroll bar of a drop-down menu that does not fit, matching the one in the suite style sheet. */

.unity-base-dropdown__container-outer .unity-scroller--vertical {
    width: 6px;
    margin-left: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__container-outer .unity-scroller__low-button,
.unity-base-dropdown__container-outer .unity-scroller__high-button {
    display: none;
}

.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider--vertical {
    top: 0;
    bottom: 0;
    margin: 0;
}

.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    right: 0;
    width: 6px;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgb(64, 68, 77);
}

.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(90, 94, 103);
}
